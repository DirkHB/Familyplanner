    "@fontsource/instrument-serif": "^5.1.0",
    "@prisma/client": "^6.3.0",
    "geist": "^1.3.1",
    "ical.js": "^2.2.1",
    "motion": "^11.15.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^3.0.3",
    "prisma": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
