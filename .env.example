# === Familienplaner — Umgebungsvariablen ===
# Lokal: kopiere diese Datei nach `.env` und fülle die Werte.
# Produktion: trage die Werte als Environment Variables im Sliplane-Service ein.
# NIEMALS echte Werte committen.

# --- Datenbank (Sliplane managed Postgres, nur internes Netzwerk) ---
# Lokal z.B.: postgresql://postgres:postgres@localhost:5432/familienplaner
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/familienplaner?schema=public"

# --- Auth.js (Magic Link) ---
# Zufälliges Secret: `openssl rand -base64 32`
AUTH_SECRET="CHANGE_ME"
# Öffentliche URL der App (Produktion: https://planyourweek.app)
AUTH_URL="http://localhost:3000"
# Allowlist — genau unsere zwei Adressen, kommagetrennt.
ALLOWED_EMAILS="dirkbrederecke@gmail.com,c.brederecke@gmail.com"

# --- Verschlüsselung der CalDAV-Zugangsdaten (Envelope Encryption) ---
# 32-Byte-Key, base64: `openssl rand -base64 32`
ENCRYPTION_KEY="CHANGE_ME"

# --- E-Mail (Resend) — Magic Link + Eskalations-Mails ---
RESEND_API_KEY=""
EMAIL_FROM="Familienplaner <plan@planyourweek.app>"

# --- Anthropic (KI, nur serverseitig) ---
ANTHROPIC_API_KEY=""

# --- Web Push (VAPID) — installierte PWA ---
# Generieren: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dirkbrederecke@gmail.com"

# --- Worker → App: interner Sync-Trigger ---
# Shared Secret, mit dem der Worker den internen Sync-Endpunkt aufruft.
# `openssl rand -base64 32`. Bei app UND worker identisch setzen.
WORKER_SECRET="CHANGE_ME"
# Optional: interne URL der App für den Worker (Default: AUTH_URL bzw. localhost).
APP_INTERNAL_URL=""

# --- Zeitzone ---
TZ="Europe/Berlin"
