// Familienplaner — Datenmodell.
// UTC überall gespeichert, Europe/Berlin angezeigt.
// Unsere Zusatzdaten hängen an der stabilen iCalendar-UID, nicht an DB-ID/href.

generator client {
  provider      = "prisma-client-js"
  // native = lokale Entwicklung; debian = Docker-Runtime (node:22-bookworm-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ------------------------------ Haushalte ------------------------------
 * Ein Haushalt sind zwei Erwachsene und ihre Daten. Bis hierher gehörte eine
 * Datenbank genau einem — jetzt teilen sich mehrere eine, und der Haushalt
 * steht an jeder Zeile, die jemandem gehört.
 * Die Spalte ist überall NOT NULL und ohne Vorgabewert. Das ist Absicht: Ein
 * Schreibzugriff, der den Haushalt vergisst, soll an der Datenbank scheitern
 * statt still in einem fremden zu landen. Für Lesezugriffe kann die Datenbank
 * das nicht leisten — dafür gibt es den Riegel in lib/prisma.
 */

model Household {
  id        String   @id @default(cuid())
  /// Nur zur Wiedererkennung in den Logs („Familie Brederecke").
  name      String?
  createdAt DateTime @default(now())

  users             User[]
  invites           Invite[]
  pushSubscriptions PushSubscription[]
  calendarAccounts  CalendarAccount[]
  calendars         Calendar[]
  events            Event[]
  eventDetails      EventDetail[]
  careAssignments   CareAssignment[]
  shoppingLists     ShoppingList[]
  shoppingItems     ShoppingItem[]
  stores            Store[]
  requests          Request[]
  ideas             Idea[]
  learnedPatterns   LearnedPattern[]
  aiFeedbacks       AiFeedback[]
  activityLogs      ActivityLog[]
  todoLists         TodoList[]
  todos             Todo[]
  briefings         Briefing[]
  careRules         CareRule[]
  appSettings       AppSetting[]
  titelRegeln       TitelRegel[]

  @@map("households")
}

/**
 * Eine Einladung: der einzige Weg herein.
 * Es gibt keine offene Anmeldung. Wer einen Link bekommt, kommt in genau den
 * Haushalt, für den er ausgestellt wurde — oder bekommt einen neuen, wenn
 * `householdId` leer ist (so lädt Dirk eine neue Familie ein).
 * Gespeichert wird nur der Hash des Tokens. Wer die Datenbank liest, kann
 * damit keine Einladung benutzen; verloren geht dabei nichts, denn den
 * Klartext braucht nur der Link in der Mail.
 */
model Invite {
  id          String     @id @default(cuid())
  /// Leer = beim Einlösen wird ein neuer Haushalt angelegt.
  householdId String?    @map("household_id")
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Nur diese Adresse kann die Einladung einlösen.
  email       String
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now())

  @@index([email])
  @@map("invites")
}

/**
 * ------------------------------- Nutzer -------------------------------
 */

model User {
  id                String    @id @default(cuid())
  householdId       String    @map("household_id")
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  /// Platz im Haushalt. Die Werte sind historisch ("dirk"/"constanze") und
  /// bedeuten nur noch Platz A und Platz B — der Name steht in `name`.
  slot              String?
  /// In welchen Kalender die App für diese Person schreibt. Leer = erstbester.
  schreibKalenderId String?   @map("schreib_kalender_id")
  /// Darf neue Haushalte einladen. Trägt genau einer: der, der die App
  /// betreibt. Ein Haushalt lädt seine zweite Person selbst ein — dafür
  /// braucht es das nicht.
  isAdmin           Boolean   @default(false) @map("is_admin")
  notificationPrefs Json      @default("{}")
  // Tagesfenster für den Zeitstrahl (7–21, wenn leer). Je Person, weil
  // Constanze und Dirk unterschiedlich takten.
  tagVonStunde      Int?      @map("tag_von_stunde")
  tagBisStunde      Int?      @map("tag_bis_stunde")
  createdAt         DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
  calendarAccounts  CalendarAccount[]
  careAssignments   CareAssignment[]
  requestsFrom      Request[]          @relation("RequestFrom")
  requestsTo        Request[]          @relation("RequestTo")
  aiFeedback        AiFeedback[]

  @@map("users")
}

/**
 * ----------------------- Auth.js (NextAuth v5) -----------------------
 */

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PushSubscription {
  id          String   @id @default(cuid())
  householdId String   @default("KEIN_HAUSHALT") @map("household_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint    String   @unique
  keys        Json
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("push_subscriptions")
}

/**
 * --------------------------- Kalender / CalDAV ---------------------------
 */

model CalendarAccount {
  id                   String   @id @default(cuid())
  householdId          String   @default("KEIN_HAUSHALT") @map("household_id")
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String   @default("icloud")
  // Apple-ID (kein Geheimnis) — das App-spezifische Passwort liegt verschlüsselt daneben.
  username             String?
  // Envelope-verschlüsselt at rest (App-spezifisches Passwort). Nie im Klartext.
  credentialsEncrypted String
  principalUrl         String?
  createdAt            DateTime @default(now())

  calendars Calendar[]

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("calendar_accounts")
}

model Calendar {
  id           String          @id @default(cuid())
  householdId  String          @default("KEIN_HAUSHALT") @map("household_id")
  accountId    String
  account      CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  url          String
  ctag         String?
  syncToken    String?
  isSynced     Boolean         @default(true)
  color        String?
  lastSyncedAt DateTime?
  lastSyncOk   Boolean         @default(true)
  lastError    String?

  events    Event[]
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([accountId, url])
  @@index([householdId])
  @@map("calendars")
}

model Event {
  id              String    @id @default(cuid())
  householdId     String    @default("KEIN_HAUSHALT") @map("household_id")
  calendarId      String
  calendar        Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  uid             String // stabile iCalendar-UID
  href            String
  etag            String?
  title           String
  start           DateTime // UTC
  end             DateTime // UTC
  allDay          Boolean   @default(false)
  location        String?
  rrule           String?
  recurrenceId    String? // RECURRENCE-ID für Einzelausnahmen einer Serie
  rawIcs          String    @db.Text
  // Googles eigene Kennung. Leer bei iCloud — dort genügt href/etag.
  providerEventId String?   @map("provider_event_id")
  status          String    @default("confirmed")
  lastSyncedAt    DateTime  @default(now())
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Eine Reihe (uid) kann mehrere Overrides (recurrenceId) haben.
  @@unique([calendarId, uid, recurrenceId])
  @@index([uid])
  @@index([householdId])
  @@map("events")
}

/**
 * --------------------- App-eigene Zusatzdaten (an UID) ---------------------
 */

model EventDetail {
  eventUid      String   @id @map("event_uid") // = iCalendar-UID
  householdId   String   @default("KEIN_HAUSHALT") @map("household_id")
  category      String   @default("sonstiges")
  notes         String?  @db.Text
  prepChecklist Json     @default("[]")
  createdBy     String?
  updatedAt     DateTime @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("event_details")
}

model CareAssignment {
  id                String    @id @default(cuid())
  householdId       String    @default("KEIN_HAUSHALT") @map("household_id")
  eventUid          String
  occurrenceDate    DateTime // welcher Serientermin (Datum)
  responsibleUserId String?
  responsible       User?     @relation(fields: [responsibleUserId], references: [id])
  fromTs            DateTime?
  toTs              DateTime?
  status            String    @default("offen") // offen | zugesagt | geklaert
  note              String?

  /// Der Kalenderblock, in dem diese Betreuung steckt. Ein Block kann mehrere
  /// überlappende Betreuungen derselben Person zusammenfassen.
  blockUid  String?   @map("block_uid")
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([eventUid, occurrenceDate])
  @@index([blockUid], map: "care_assignments_block_uid_idx")
  @@index([householdId])
  @@map("care_assignments")
}

/**
 * ------------------------------ Einkaufslisten ------------------------------
 */

model ShoppingList {
  id          String         @id @default(cuid())
  householdId String         @default("KEIN_HAUSHALT") @map("household_id")
  kind        String         @default("haupt") // haupt | termin
  eventUid    String?
  name        String
  items       ShoppingItem[]

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("shopping_lists")
}

model ShoppingItem {
  id          String       @id @default(cuid())
  householdId String       @default("KEIN_HAUSHALT") @map("household_id")
  listId      String
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  eventUid    String?
  text        String
  quantity    String?
  category    String? // Alt: Laden als fester Schlüssel. Ersetzt durch storeId.
  storeId     String?      @map("store_id")
  store       Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  addedBy     String?
  checkedBy   String?
  checkedAt   DateTime?
  createdAt   DateTime     @default(now())
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([storeId])
  @@index([householdId])
  @@map("shopping_items")
}

/**
 * Ein Laden, in dem ihr einkauft. Früher fünf fest verdrahtete Namen im Code —
 * jetzt Zeilen, damit ihr sie selbst anlegen könnt.
 * `storeId = null` ist bewusst kein Laden, sondern das Fach „Sonstiges": Es ist
 * immer da, lässt sich nicht löschen und fängt alles auf, was beim Löschen
 * eines Ladens heimatlos wird.
 */
model Store {
  id          String         @id @default(cuid())
  householdId String         @default("KEIN_HAUSHALT") @map("household_id")
  name        String
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now())
  items       ShoppingItem[]

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("stores")
}

/**
 * ------------------------------ Anfragen ------------------------------
 */

model Request {
  id             String    @id @default(cuid())
  householdId    String    @default("KEIN_HAUSHALT") @map("household_id")
  fromUserId     String
  fromUser       User      @relation("RequestFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User      @relation("RequestTo", fields: [toUserId], references: [id])
  eventUid       String?
  /// Das konkrete Vorkommen, um das es geht. Leer = gilt für den Termin
  /// allgemein (Anfragen von vor Migration 0016).
  occurrenceDate DateTime? @map("occurrence_date")
  question       String
  type           String    @default("yes_no") // yes_no | choice | free_text | date
  options        Json      @default("[]")
  answer         String?
  status         String    @default("open") // open | answered | declined
  dueDate        DateTime?
  lastNudgeAt    DateTime?
  createdAt      DateTime  @default(now())
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([eventUid, occurrenceDate, status], map: "requests_event_occurrence_idx")
  @@index([householdId])
  @@map("requests")
}

/**
 * ------------------------------ Ideen-Board ------------------------------
 */

model Idea {
  id           String   @id @default(cuid())
  householdId  String   @default("KEIN_HAUSHALT") @map("household_id")
  type         String // urlaub | ausflug | restaurant | geschenk
  title        String
  description  String?
  link         String?
  images       Json     @default("[]")
  votes        Json     @default("{}")
  targetPeriod String?
  status       String   @default("offen")
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("ideas")
}

/**
 * ------------------------------ KI ------------------------------
 */

model LearnedPattern {
  id          String   @id @default(cuid())
  householdId String   @default("KEIN_HAUSHALT") @map("household_id")
  label       String // im UI lesbar & editierbar
  pattern     Json
  source      String   @default("gelernt")
  isActive    Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("learned_patterns")
}

model AiFeedback {
  id                String   @id @default(cuid())
  householdId       String   @default("KEIN_HAUSHALT") @map("household_id")
  suggestionId      String
  suggestionPayload Json
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  action            String // accepted | rejected | edited
  editedResult      Json?
  createdAt         DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("ai_feedback")
}

/**
 * ------------------------------ Protokoll ------------------------------
 */

model ActivityLog {
  id          String    @id @default(cuid())
  householdId String    @default("KEIN_HAUSHALT") @map("household_id")
  entityType  String
  entityId    String
  action      String
  actor       String? // "sync" | userId
  detail      Json      @default("{}")
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([householdId])
  @@map("activity_log")
}

/**
 * ------------------------------ Aufgaben ------------------------------
 */

/**
 * Eine Aufgabenliste — „Haushalt", „Nicolas", „Papierkram".
 * `listId = null` heißt „Ohne Liste" und ist kein Mangel: Der schnelle
 * Eintrag zwischendurch soll nicht erst eine Einordnung verlangen.
 */
model TodoList {
  id          String   @id @default(cuid())
  householdId String   @default("KEIN_HAUSHALT") @map("household_id")
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now())
  todos       Todo[]

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("todo_lists")
}

model Todo {
  id          String    @id @default(cuid())
  householdId String    @default("KEIN_HAUSHALT") @map("household_id")
  listId      String?   @map("list_id")
  list        TodoList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  title       String
  notes       String?
  dueDate     DateTime? // ETA (Fälligkeit)
  assignee    String? // "dirk" | "constanze"
  createdBy   String? // Person, die die Aufgabe angelegt hat
  status      String    @default("offen") // offen | erledigt
  eventUid    String? // optionaler Terminbezug
  important   Boolean   @default(false) // nur für Undatiertes: hebt es im Fach „Irgendwann"
  shiftCount  Int       @default(0) @map("shift_count") // wie oft "auf morgen" geschoben
  remindAt    DateTime? // wann erinnert werden soll
  remindedAt  DateTime? // wann tatsächlich erinnert wurde (einmalig)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  /**
   * Herkunft aus iCloud Erinnerungen (VTODO-UID). Nur dafür da, dass ein
   * zweiter Klick auf „Übernehmen" nichts verdoppelt. Danach unbenutzt — es
   * gibt keinen Abgleich zurück.
   */
  sourceUid   String?   @map("source_uid")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
  @@index([listId])
  @@index([sourceUid])
  @@index([householdId])
  @@map("todos")
}

/**
 * ------------------------------ Briefings ------------------------------
 */

model Briefing {
  id          String    @id @default(cuid())
  /// Wem gehört das? Solange eine Datenbank einem Haushalt gehört, immer '1'.
  householdId String    @default("KEIN_HAUSHALT") @map("household_id")
  kind        String // morgen | woche
  dayKey      String // YYYY-MM-DD (Berlin) — ein Briefing je Art und Tag
  summary     String    @db.Text
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, kind, dayKey])
  @@map("briefings")
}

/**
 * --------------------------- Betreuungs-Regeln ---------------------------
 */

/**
 * „Dafür braucht es nie eine Betreuung." Gilt pro Titel-Art, nicht pro
 * Vorkommen — sonst müsste man die wöchentliche Müllabfuhr jede Woche neu
 * abwinken. Der Schlüssel kommt aus titleKey() in lib/care/gaps.ts.
 */
/**
 * Einmal fragen, Antwort merken — für alles außer Betreuung.
 * Dieselbe Idee wie CareRule, nur allgemein: Die Antwort gilt der ART des
 * Eintrags, nicht dem einzelnen Vorkommen. Wer einmal gesagt hat „Sprung 2 ist
 * kein Wegsein", soll nicht bei jeder Babyphase erneut gefragt werden.
 */
model TitelRegel {
  id           String    @id @default(cuid())
  householdId  String    @default("KEIN_HAUSHALT") @map("household_id")
  /// "abwesenheit" (seid ihr weg? — vom Menschen beantwortet)
  /// "einordnung" (was der Eintrag heißt — von der KI vermutet, createdBy leer)
  /// "geschenk" (Geschenk besorgen?)
  art          String
  titleKey     String    @map("title_key")
  /// "ja" | "nein" — bei art "einordnung" stattdessen
  /// "wegfahrt" | "besuch" | "zustand" | "unklar"
  entscheidung String
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, art, titleKey])
  @@index([householdId])
  @@map("titel_regeln")
}

model CareRule {
  id          String    @id @default(cuid())
  /// Wem gehört das? Solange eine Datenbank einem Haushalt gehört, immer '1'.
  householdId String    @default("KEIN_HAUSHALT") @map("household_id")
  titleKey    String    @map("title_key")
  decision    String    @default("keine") // keine = nicht nach Betreuung fragen
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  household   Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, titleKey])
  @@map("care_rules")
}

/**
 * ------------------------------ Einstellungen ------------------------------
 */

/**
 * Schalter, die für die App als Ganzes gelten (nicht pro Person). Bewusst als
 * Schlüssel/Wert: Es sind wenige, sie kommen selten dazu, und ein eigenes Feld
 * je Schalter wäre eine Migration für jede Kleinigkeit.
 */
model AppSetting {
  key         String
  householdId String   @default("KEIN_HAUSHALT") @map("household_id")
  value       String
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([householdId, key])
  @@index([householdId])
  @@map("app_settings")
}
